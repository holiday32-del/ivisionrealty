{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ivisionrealtycorp",
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "images": {
    "binding": "IMAGES"
  }
}
